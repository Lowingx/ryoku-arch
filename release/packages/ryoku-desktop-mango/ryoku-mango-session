#!/bin/sh
# The Ryoku mango session entry, launched by the greeter in place of a bare
# `Exec=mango`.
#
# A machine whose config was never laid down boots a bare compositor: no
# keybinds, no autostart, no shell, just mango's own defaults. The
# ryoku-bootstrap unit covers sessions that are systemd user units; mango's
# entry is a greeter exec, so no drop-in can order it. This wrapper closes
# that lane: materialize synchronously when the tree is missing, then exec
# mango, which still does its own env push and target activation.
#
# materialize is declarative and preserves user files, so a second run (the
# bootstrap racing a login, or an update) is harmless rather than a reason to
# refuse. The entry file is the marker: config.conf is the one file whose
# absence means mango boots its own defaults instead of Ryoku's tree, and the
# generated settings/rebinds it sources are complete by apply's contract.
set -eu

config="${XDG_CONFIG_HOME:-$HOME/.config}"

if [ ! -f "$config/mango/config.conf" ] && command -v ryoku >/dev/null 2>&1; then
	ryoku materialize || true
fi

exec mango "$@"
