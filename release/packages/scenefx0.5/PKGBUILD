# Maintainer: Ryoku <releases@ryoku.dev>
#
# scenefx0.5: the wlroots scene-API replacement mango renders through (blur,
# shadows, rounding). Ryoku ships it because the alternative is AUR-only: the
# desktop's install path is the [ryoku] repo, and a compositor that needs an
# AUR build at install time makes the mango variant a worse first login than
# the other two. Drop-in name and version match the AUR recipe (fixed tag
# 0.5, not git), so a future official or AUR package of the same name sorts
# equal and nothing double-installs.
pkgname=scenefx0.5
_pkgname=scenefx
pkgver=0.5
pkgrel=1
pkgdesc="A drop-in replacement for the wlroots scene API that allows Wayland compositors to render surfaces with eye-candy effects"
arch=('x86_64')
url="https://github.com/wlrfx/scenefx"
license=('MIT')
depends=(
  'libdrm'
  'libglvnd'
  'libpixman-1.so'
  'wlroots0.20'
  'wayland'
)
makedepends=(
  'glslang'
  'meson'
  'ninja'
  'wayland-protocols'
)
provides=('libscenefx-0.5.so')
conflicts=('scenefx-git' 'scenefx')
replaces=('scenefx')
source=("$_pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('0fa8ecca0e310f813efd052624c5ed7d9153d6a0fdead5cc957d34c07f9a86c6')
options=('!debug')

build() {
  arch-meson "$_pkgname-$pkgver" build
  meson compile -C build
}

package() {
  DESTDIR="$pkgdir" meson install -C build
}
